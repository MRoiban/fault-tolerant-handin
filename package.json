{
    "name": "fault-tolerant-k-centre",
    "private": true,
    "version": "0.1.0",
    "description": "An interactive game that teaches the fault-tolerant Euclidean k-centre problem (Durocher, Lamey, Li, CCCG 2025).",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build && node scripts/add-report.mjs && node scripts/verify-dist.mjs",
        "preview": "vite preview",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "zip": "npm run build && node scripts/make-zip.mjs"
    },
    "dependencies": {
        "poisson-disk-sampling": "^2.3.1",
        "seedrandom": "^3.0.5",
        "three": "^0.187.0"
    },
    "devDependencies": {
        "@types/d3-hierarchy": "^3.1.7",
        "@types/poisson-disk-sampling": "^2.2.4",
        "@types/seedrandom": "^3.0.8",
        "@types/three": "^0.187.0",
        "d3-hierarchy": "^3.1.3",
        "fflate": "^0.8.3",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "vite": "^8.0.0",
        "vite-plugin-singlefile": "^2.3.4",
        "vitest": "^5.1.0"
    }
}
